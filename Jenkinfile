pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/Sourabhf4/Devops-agent.git'
            }
        }

        stage('Prepare Environment') {
            steps {
                script {
                    sh '''
                        if [ -f .env.example ]; then
                            cp .env.example .env
                        else
                            touch .env
                        fi
                    '''
                }
            }
        }

        stage('Build & Run Frontend and Backend') {
            steps {
                // Dynamically create the missing public directory so the Dockerfile copy command succeeds
                sh '''
                    echo "Creating dummy public directory to satisfy the Dockerfile..."
                    mkdir -p frontend/public
                    
                    echo "Starting Devops Agent containers..."
                    docker compose down --remove-orphans || true
                    docker compose up -d --build
                '''
            }
        }

        stage('Verify Containers') {
            steps {
                sh 'docker compose ps'
            }
        }
    }

    post {
        success {
            echo "Deployment successful!"
        }
        failure {
            echo "Pipeline failed. Please check the logs."
        }
    }
}
